# -----------------------------------------------------------------------------
# GoodSale — live backend credentials
# Copy to .env.local. Mock marketplace data has been removed.
# -----------------------------------------------------------------------------

# Demo mode is off by default — use real Supabase Auth
NEXT_PUBLIC_DEMO_MODE=false

# Public site URL (SEO + auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini — server-side only
GEMINI_API_KEY=

# Supabase (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (required for live checkout)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Google Maps (SafeMeet + GoodDispatch live tracking)
# Enable Maps JavaScript API, Maps Embed API, and Geocoding API for the key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

LOG_LEVEL=info
