# -----------------------------------------------------------------------------
# GoodSale environment template
# Copy to .env.local for local development. Never commit real secrets.
# -----------------------------------------------------------------------------

# Set to "false" for production hardening (disables guest login, mock payments,
# instant ID verify, email SUPER_ADMIN backdoors, and open /api/db sync).
# Defaults: true in development, false when NODE_ENV=production.
NEXT_PUBLIC_DEMO_MODE=true

# Public site URL (used for SEO canonical / sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini — server-side only (marketplace AI tips & moderation)
GEMINI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only privileged key (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — use public key on client; secret key only on server
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Optional: verify webhook signatures from Paystack
PAYSTACK_WEBHOOK_SECRET=

# Google Maps (SafeMeet live map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Logging: debug | info | warn | error
LOG_LEVEL=info
