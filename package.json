{
  "name": "goodsale",
  "version": "0.2.0",
  "private": true,
  "description": "GoodSale — Nigeria's escrow-backed C2C marketplace",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "healthcheck": "curl -fsS http://localhost:3000/api/health",
    "migrate": "node scripts/apply-migrations.mjs",
    "seed": "tsx scripts/seed-marketplace.ts",
    "seed:reset": "tsx scripts/seed-marketplace.ts --force",
    "verify:realtime": "tsx scripts/verify-realtime.ts",
    "verify:tracking": "node scripts/verify-premium-tracking.mjs",
    "verify:wallet": "node scripts/verify-wallet-ledger.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.2",
    "jspdf": "^4.2.1",
    "lottie-react": "^3.1.0",
    "lucide-react": "^0.469.0",
    "motion": "^11.11.17",
    "next": "15.5.20",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/google.maps": "^3.65.3",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
